# Copy this file to .env and fill in real values, or export these in your
# shell before running `docker compose up`. Do not commit a real .env file.

# --- Required, no default (docker-compose and the backend refuse to start
# without these) ---

# Bearer token required on every REST API request (see docs/api.md).
# Generate a long random string, e.g.: openssl rand -hex 32
API_TOKEN=

# Password for the Asterisk ARI user the backend authenticates as.
# Generate a long random string, e.g.: openssl rand -hex 32
ARI_PASSWORD=

# Postgres password, used by both the `postgres` and `backend`/`migrate`
# services.
POSTGRES_PASSWORD=

# --- Optional, have defaults baked into docker-compose.yml ---

# Postgres user. Optional, defaults to "homephone".
POSTGRES_USER=homephone

# Postgres database name. Optional, defaults to "homephone".
POSTGRES_DB=homephone

# --- Set automatically by docker-compose.yml, listed here for reference
# only (do not set these yourself when running via docker compose) ---

# Postgres connection string (built from the vars above + sslmode=require).
# DATABASE_URL=postgres://homephone:<POSTGRES_PASSWORD>@postgres:5432/homephone?sslmode=require

# Base URL of the Asterisk ARI HTTP interface.
# ARI_BASE_URL=http://asterisk:8088

# Username the backend uses to authenticate to ARI. Optional, defaults to
# "homephone".
# ARI_USER=homephone

# Name of the Asterisk Stasis application the backend registers as.
# Optional, defaults to "homephone".
# ARI_APP_NAME=homephone

# Address the backend's HTTP API listens on. Optional, defaults to ":8080".
# HTTP_ADDR=:8080

# --- Only used when running the e2e test suite directly (not via
# docker-compose), see docs/testing.md ---

# Override the docker container name used for the "device" SIP leg in e2e
# tests. Optional.
# SIP_DEVICE_CONTAINER=

# Override the docker container name used for the "trunk" SIP leg in e2e
# tests. Optional.
# SIP_TRUNK_CONTAINER=
